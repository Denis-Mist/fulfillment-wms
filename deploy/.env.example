# /opt/wms/.env на СЕРВЕРЕ (root:root, chmod 600). Не коммитить!
# server-setup.sh создаёт файл сам и генерирует секреты (openssl rand -hex 32).
# Используется как --env-file для deploy/docker-compose.yml.
POSTGRES_PASSWORD=
WMS_API_PORT=5080

# Конфигурация ASP.NET Core (двойное подчёркивание = секция).
# Ключи нельзя менять на работающей системе: Jwt — разлогинит всех, ProtectionKey — зашифрованные
# токены маркетплейсов станут нечитаемыми.
Jwt__SigningKey=
Marketplace__ProtectionKey=
Database__MigrateOnStartup=true
Database__Seed=true
# Строку подключения API собирает docker-compose.yml (Host=postgres). Старые переменные
# ConnectionStrings__Wms / WMS_DB_PORT от схемы с systemd больше не используются и игнорируются.
